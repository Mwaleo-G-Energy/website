# Public Wix Headless OAuth client ID from the Mwaleo site.
NEXT_PUBLIC_WIX_CLIENT_ID=

# Server-only secret for the same Wix client. Enables the contact form and delivery fees.
WIX_CLIENT_SECRET=

# Wix Stores category IDs for the two homepage sections.
FEATURED_PRODUCTS_CATEGORY_ID=
NEW_PRODUCTS_CATEGORY_ID=

# Optional WhatsApp number in international digits, without + or spaces.
NEXT_PUBLIC_MWALEO_WHATSAPP_NUMBER=

# Optional approved free-delivery threshold in KES.
NEXT_PUBLIC_MWALEO_FREE_DELIVERY_FROM=

# Set to true to serve the maintenance notice instead of the storefront.
MWALEO_MAINTENANCE_MODE=
